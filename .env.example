# Copy to .env.local (local) and set the same names in Vercel (production).
# Never commit real values. Never put a Supabase service_role key here.

# Supabase project. Both values are public by design; access is enforced by row
# level security.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Google Drive (the Hub's file storage). Server only: these must NOT start with
# NEXT_PUBLIC_. Steps are in progress.md, entry "Google Drive as the file store".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Filled in once, from the page the Hub shows after an administrator presses
# "ربط Google Drive" (Admin, Integrations or the Media page).
GOOGLE_DRIVE_REFRESH_TOKEN=
# Optional: pre-selects the Google account on the consent screen.
GOOGLE_DRIVE_ACCOUNT_HINT=commshubhadayah@gmail.com
# Optional: pin the Hub's Drive folder instead of finding "Comms Hub" by marker.
GOOGLE_DRIVE_FOLDER_ID=

# Mail: the department mailbox (Gmail over IMAP and SMTP). Server only: none of these
# may start with NEXT_PUBLIC_. Steps are in progress.md, entry "Mail page".
GMAIL_ADDRESS=
# A Google app password for that account (needs 2-Step Verification on it).
GMAIL_APP_PASSWORD=
# Proves the server to the database. 32 random bytes as hex; only its sha256 is stored
# in the database (public.mail_server_key). The same value goes in Vercel.
MAIL_SERVER_KEY=
# Optional: the Hub's public address, for the date buttons and review links in mail
# sent outside. Defaults to the address the request came to.
MAIL_SITE_URL=
