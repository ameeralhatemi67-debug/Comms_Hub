# Copy to .env in this folder. Never commit .env.
# The site's public address, for example the Vercel production address.
COMMS_SITE_URL=
# The same value as WHATSAPP_SERVER_KEY in Vercel. Only its sha256 is in the database.
WHATSAPP_SERVER_KEY=
# Optional: the browser the bridge drives. Defaults to Edge, then Chrome, at their usual paths.
COMMS_CHROME_PATH=
# Optional: where the linked session is kept. Defaults to bridge\whatsapp\.session
COMMS_WA_DATA=
