{
  "appId": "sa.commshub.app",
  "appName": "مركز الاتصال المؤسسي",
  "webDir": "www",
  "loggingBehavior": "none",
  "zoomEnabled": false,
  "server": {
    "url": "https://comms-hub-three.vercel.app",
    "errorPath": "offline.html",
