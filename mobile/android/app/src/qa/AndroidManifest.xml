<?xml version="1.0" encoding="utf-8"?>
<!-- The check package only: a push handed in by the check (QaPush.java, qa/android-push.cjs). Nothing of it is in a
     release or a development build. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <receiver
            android:name=".QaPush"
            android:exported="true" />
        <!-- Files to share into the application (QaFiles.java, qa/android-upload.cjs). -->
        <provider
            android:name=".QaFiles"
            android:authorities="${applicationId}.qafiles"
            android:exported="true" />
    </application>
</manifest>
